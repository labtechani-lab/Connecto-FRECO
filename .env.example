# CONNECTO Environment Configuration
# Copy this file to .env.local to enable real database & authentication.
# DO NOT COMMIT .env.local to Git.

# 1. Supabase Project URL (Found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon/Public Key (Safe for browser / frontend usage with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: Never put the Supabase service_role key here. The service_role key bypasses RLS and must NEVER be exposed to the browser.
